# Career Agent — environment variables
# Copy to .env and fill in the required values. Never commit .env.
# docker-compose.yml overrides PARSER_URL, PDF_SERVICE_URL, DB_PATH, VACANCIES_PATH
# to internal container addresses — those only matter for local (non-Docker) runs.

# ── Required ──────────────────────────────────────────────────────────────────


LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
# Timeout in seconds for Ollama HTTP read (0 = no timeout; default: 300).
# Set to 0 for slow thinking models like qwen3:8b that can run 10+ minutes.
OLLAMA_TIMEOUT=300

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (integer) — get it from @userinfobot
TELEGRAM_CHAT_ID=

# ── LLM ───────────────────────────────────────────────────────────────────────

# Claude model to use (default: claude-opus-4-5)
# LLM_MODEL=claude-opus-4-5

# ── Services (local dev — Docker overrides these) ─────────────────────────────

# jd-parser service URL (default: http://localhost:8001)
# PARSER_URL=http://localhost:8001

# pdf-render service URL (default: http://localhost:8002)
# PDF_SERVICE_URL=http://localhost:8002

# ── Storage ───────────────────────────────────────────────────────────────────

# SQLite DB path (default: db/agent.db)
# DB_PATH=db/agent.db

# Vacancy folders root (default: vacancies)
# VACANCIES_PATH=vacancies

# ── Pipeline ──────────────────────────────────────────────────────────────────

# Default skill_type — routes prompts/[skill_type]/ (default: pm)
# Options: pm | generic
# DEFAULT_SKILL_TYPE=pm

# Candidate display name used in CV header (default: Candidate)
# CANDIDATE_NAME=Your Name

# Agent mode: "production" (default) | "testing" (confirm before each LLM call)
# AGENT_MODE=production

# Allow outbound HTTP to external services (Claude API, Web Push, etc.)
# Default: false — ExternalCallBlocked raised on any external call.
# Set to true for local testing with real API, or in production.
# ALLOW_EXTERNAL_CALLS=false

# Max tokens per LLM call (default: 4096)
# MAX_TOKENS=4096

# ── Multi-user ────────────────────────────────────────────────────────────────

# Allow any Telegram user to onboard (default: false — single-user mode).
# When false, only TELEGRAM_CHAT_ID is accepted.
# MULTI_USER_ENABLED=false

# ── RSS / job-monitor ─────────────────────────────────────────────────────────

# Seconds between seen_jobs.json polls (default: 60)
# RSS_POLL_INTERVAL=60

# User ID labels referenced in services/job-monitor/feeds.json.
# Each label maps a feed's user_ids entry to a career-agent DB user ID.
# CAREER_AGENT_USER_1=1   — Alex (telegram_chat_id=319987251), feeds: DOU PM, DOU PjM, Djinni PM/PO
# CAREER_AGENT_USER_2=2   — Maria (telegram_chat_id=637454887), feeds: DOU/Djinni Assistant
CAREER_AGENT_USER_1=1
# CAREER_AGENT_USER_2=2

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Required for browser push notifications (Flutter PWA / web target).
# Not needed for Flutter Windows Desktop (uses polling + flutter_local_notifications).
#
# Generate keys (one-time):
#   python -c "
#   from py_vapid import Vapid; import base64
#   v = Vapid(); v.generate_keys()
#   print('VAPID_PRIVATE_KEY=' + v.private_pem().decode())
#   print('VAPID_PUBLIC_KEY=' + base64.urlsafe_b64encode(
#       v.public_key.public_bytes(
#           __import__('cryptography.hazmat.primitives.serialization', fromlist=['Encoding']).Encoding.X962,
#           __import__('cryptography.hazmat.primitives.serialization', fromlist=['PublicFormat']).PublicFormat.UncompressedPoint
#       )
#   ).decode())
#   "
# VAPID_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----
# VAPID_PUBLIC_KEY=BNxyz...
# VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# ── PDF service ───────────────────────────────────────────────────────────────

# Path to fonts directory — Segoe UI + Calibri required for PDF rendering.
# Fonts are not included in the repo (licensed). Copy from C:/Windows/Fonts/ or provide your own.
# Docker mounts ./fonts:/app/fonts automatically — this var is only needed for local uvicorn runs.
# CAREER_AGENT_FONTS=fonts/

