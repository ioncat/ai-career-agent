# Claude Code (local session memory and settings — stays with project, not pushed)
.claude/sessions/
.claude/memory/
.claude/todos/
# .claude/commands/ is tracked — project slash commands belong in repo

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
*.egg

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Project-specific
config/profile.yaml
vacancies/
# runtime file from job-board-monitor / emit_vacancy.py
seen_jobs.json
# job-monitor lock file (runtime, prevents double-start)
services/job-monitor/monitor.lock
# SQLite runtime DB and backups — not versioned
*.db
*.sqlite
*.sqlite3
*.db.backup*
*.db-shm
*.db-wal
*.bak
db/backups/

# Internal dev guidelines and discovery docs (not for public repos)
CLAUDE.md
docs/discovery/

# Skill pipeline — base files (SKILL.md, SKILL_TYPES.md, users.yaml) are tracked.
# Personal data (user profiles, active_user state) is private.
skill/users/
skill/active_user

# Fonts — licensed, not for public repo (copy from C:/Windows/Fonts/ or callback-cv/fonts/)
# Anchored to repo root — flutter/assets/fonts/ is OFL-licensed (Google
# Fonts), explicitly free to redistribute, and must stay tracked.
/fonts/

# Windows OS junk
*.lnk

# Local startup scripts — machine-specific paths, not for repo
*.bat
*.vbs

# Claude Code local config (launch settings, not project config)
.claude/launch.json

# Chat logs / Q&A notes (local only)
*Q&A*.md
Previous chat.md
.foglamp/
